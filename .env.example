# Canonical public URL of the site, no trailing slash.
# Used for metadataBase, Open Graph tags, robots.txt, sitemap.xml and JSON-LD.
#
# Must be set at BUILD time, not just at runtime: robots.txt and sitemap.xml are
# prerendered during `next build`, so changing this later needs a redeploy.
#
# On Vercel this can be left unset for preview deploys — NEXT_PUBLIC_VERCEL_URL
# is used automatically. Set it explicitly for production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
